# ============================================================
# SSB Border Screening - SIH26188: AI-Based Fake Identity &
# Document Screening - Environment Template
# Copy to `.env`, fill in real values, and NEVER commit `.env`.
# ============================================================
#
# SECURITY NOTE: the app now REFUSES TO START if DATABASE_URL or
# MASTER_VAULT_KEY is missing, and refuses a MASTER_VAULT_KEY shorter
# than 32 bytes. There are no built-in defaults. If a value below looks
# like a real credential, rotate it -- an earlier revision of this
# project shipped a live database password and a fallback signing key
# in source.

# ---------------------------------------------------------------------------
# REQUIRED — database
# ---------------------------------------------------------------------------
# Any SQLAlchemy URL. PostgreSQL (Neon/RDS) is what production and Vercel
# should use. The app creates its tables and runs its migrations on first
# database access.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DB?sslmode=require

# Offline / edge desks only. Set to 1 to fall back to a local SQLite file
# (WAL mode) when DATABASE_URL is unset. SQLite serialises all writes, so a
# busy shift queues on the writer lock. Do NOT use in production.
# ALLOW_LOCAL_SQLITE=1

# ---------------------------------------------------------------------------
# REQUIRED — cryptographic key material
# ---------------------------------------------------------------------------
# Signs session cookies, dossier seals, the BSA 65B certificate, shift
# handover tokens and the ledger anchor. Minimum 32 bytes. Generate one with:
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# Session tokens and evidence seals use SEPARATE derived sub-keys, so a
# signature made in one context cannot be replayed in the other.
MASTER_VAULT_KEY=

# Key rotation. When you roll the key forward, put the OUTGOING key here and
# it will still be accepted for VERIFICATION (so existing session cookies and
# seals keep validating) while everything new is signed with the new key.
# Remove it once the old key's 24h session lifetime has fully elapsed.
# MASTER_VAULT_KEY_PREV=

# ---------------------------------------------------------------------------
# REQUIRED — Google OAuth
# ---------------------------------------------------------------------------
# OAuth 2.0 client ID of the Google Cloud project owning this deployment.
# Used by the GSI button in the frontend AND by backend id_token
# verification; they must be the same project. The app refuses to start
# without it.
GOOGLE_CLIENT_ID=

# ---------------------------------------------------------------------------
# Who may sign in. All lists default to EMPTY, and with all three empty
# NOBODY can sign in. That is deliberate: a misconfigured deployment is
# inaccessible, not open. Add SUPER_ADMINS here (or in your hosting
# provider's secret store) or you will lock yourself out.
# ---------------------------------------------------------------------------
# Comma-separated domains. Matches BOTH the id_token `hd` claim (Google
# Workspace) AND the email's own "@domain" suffix. Anyone in one of these
# domains may sign in automatically -- manage membership in Google Cloud,
# no code change needed.
# ALLOWED_DOMAINS=ssb.gov.in

# Comma-separated exact addresses (needed for personal gmail accounts, which
# carry no `hd` claim).
# ALLOWED_EMAILS=officer1@example.com,officer2@example.com

# Comma-separated addresses with root clearance: assign officer roles, work
# the review queue, manage the watchlist, run the shift export. They bypass
# the allow-list gate.
#
# COMMENTED OUT ON PURPOSE. If you uncomment the example addresses below they
# become real administrators. Put your own in instead.
# SUPER_ADMINS=your.address@example.com,second.admin@example.com

# ---------------------------------------------------------------------------
# Rate limiting (optional but recommended in production)
# ---------------------------------------------------------------------------
# Without this, the limiter is per-process: on Vercel every serverless
# instance keeps its own counters, so the effective limit is N x the value
# below. Point this at a shared Redis (Upstash, Vercel KV, Redis Cloud).
# REDIS_URL=redis://default:password@host:6379

# ---------------------------------------------------------------------------
# Neon keep-alive (optional)
# ---------------------------------------------------------------------------
# Seconds between `SELECT 1` pings that stop serverless Postgres suspending
# after ~5 min idle. 0 disables. Ignored on Vercel.
# KEEPALIVE_INTERVAL=45

# ---------------------------------------------------------------------------
# Privacy retention (optional)
# ---------------------------------------------------------------------------
# Unmasked identity fields are held only while a screening session is open, so
# the desk can cross-compare documents. They are wiped on close, flag,
# adjudication and document-removal. A supervisor can also sweep sessions that
# have been idle longer than this many minutes, bounding how long a forgotten
# session can retain raw data.
# RAW_FIELD_TTL_MINUTES=240

# ---------------------------------------------------------------------------
# Optional: remote AI/ML microservice
# ---------------------------------------------------------------------------
# When set, heavy inference (YOLO card ROI, Aadhaar field parsing, ArcFace
# embeddings, the ViT AI detector) is dispatched to this service instead of
# running locally.
#
# LEAVE THIS BLANK unless you have actually deployed one. The value below is a
# placeholder, and a non-empty value is treated as "configured" -- so pasting
# it verbatim would make the app try to reach a URL that does not exist.
ML_SERVICE_URL=
# ML_SERVICE_TIMEOUT=6.0
# ML_CONNECT_TIMEOUT=2.0

# ---------------------------------------------------------------------------
# Optional: officer assistant (/api/chat)
# ---------------------------------------------------------------------------
# WARNING: this is a CLOUD LLM, not an offline knowledge base. Each call sends
# the officer's question plus a retrieved slice of this repository's source to
# Google Gemini. Secret-bearing and security-critical files (app/main.py,
# app/keys.py, app/session.py, api/index.py, scripts/anchor_ledger.py) and any
# .env are excluded from that retrieval. The endpoint requires a signed-in
# officer. Unset => a static offline guide is used instead.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite

# Optional: OpenAI-compatible proxy, used for structured field extraction and
# session-discrepancy analysis. Unset => skipped entirely.
# LITELLM_URL=
# LITELLM_API_KEY=

# ---------------------------------------------------------------------------
# Optional: ledger anchoring (external notarisation)
# ---------------------------------------------------------------------------
# Publishes the ledger head to a PUBLIC GitHub Gist as a tamper-evident
# anchor. The manifest includes the anchoring officer's email address, so
# treat the gist as public. Unset => in-app anchor only.
# GITHUB_TOKEN=
# LEDGER_GIST_ID=

# ---------------------------------------------------------------------------
# Optional: face-match and detector models
# ---------------------------------------------------------------------------
# ArcFace/FaceNet-style .onnx for production face matching. Unset => a
# whole-image perceptual dHash fallback (coarse; runs anywhere).
# FACE_EMBED_MODEL=data/models/w600k_r50.onnx

# Local ID-card ROI detector (worker only). Auto-loads app/models/card.onnx.
# YOLO_ROI_ONNX_PATH=app/models/card.onnx

# 5-class Aadhaar field detector (Name/DOB/Gender/Aadhaar_No/Photo), used by
# yolo_roi.extract_aadhaar_fields for the national-ID OCR route.
# AADHAAR_FIELDS_ONNX_PATH=app/models/aadhaar_fields.onnx

# --- Optional: cloud AI tampering-detector backends (server/worker only) ---
# Blank provider => local heuristic. Sightengine needs an `api_user:api_secret`
# pair; self-hosted needs onnxruntime plus a model cache outside the bundle.
# AI_DETECTOR_PROVIDER=
# AI_DETECTOR_KEY=
# AI_DETECTOR_ENDPOINT=
# AI_DETECTOR_MODEL_URL=
# AI_DETECTOR_MODEL_DIR=

# ---------------------------------------------------------------------------
# Optional: deployment environment
# ---------------------------------------------------------------------------
# Marks a deployment as production: forces the Secure flag on session cookies
# and tightens CORS to the configured origin list.
# ENVIRONMENT=production

# Exact browser origins permitted to call the API. Leave unset if the frontend
# is served from the same origin as the API (the default deployment), in which
# case no cross-origin access is needed at all.
# CORS_ORIGINS=https://your-deployment.example.com

# Adds the CORS headers needed for local frontend development (Vite on :5173).
# ALLOW_DEV_CORS=1

# ---------------------------------------------------------------------------
# Optional: deployment
# ---------------------------------------------------------------------------
# VERCEL=1 is injected automatically by Vercel. It forces Secure cookies and
# disables the keep-alive thread. Do not set it manually.
# VERCEL=1
