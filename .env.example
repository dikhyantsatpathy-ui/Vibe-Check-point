# ==============================================================================
# NO-CAP (SIH26188) — Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure values for your environment.
# NEVER commit .env with real credentials to source control.

# ---- Database (Neon PostgreSQL) ----
DATABASE_URL=

# ---- Cryptographic Keys & Security Vault ----
SESSION_SECRET=
MASTER_VAULT_KEY=
ML_SERVICE_SECRET=
ML_SECRET_KEY=

# ---- ML Microservice URL ----
ML_SERVICE_URL=

# ---- Model Detector Backend Flags ----
# Global fallback: "yolov8" (default) or "rf_detr"
DETECTOR_BACKEND=

# Stage 1 Card Localization: "yolov8" (default) or "rf_detr"
CARD_DETECTOR_BACKEND=

# Stage 2 Field Zone Detection: "yolov8" (default) or "rf_detr"
FIELD_DETECTOR_BACKEND=

# MRZ Isolation: "bottom20" (default) or "rf_detr"
MRZ_DETECTOR_BACKEND=

# Document Type Classifier: "v1" (default) or "v2"
DOCTYPE_BACKEND=

# Image Forensics Tamper Detector: "deterministic" (default) or "learned_patch"
TAMPER_MODEL_BACKEND=

# ---- Hugging Face Model Artifact Hub ----
HF_MODEL_REPO=
HF_MODEL_REVISION=
HF_TOKEN=
MODEL_CACHE_DIR=

# ---- Multimodal Cloud Fallback (Strictly Opt-in) ----
ENABLE_GEMINI_FALLBACK=
GEMINI_API_KEY=

# ---- Application Server Profile ----
PORT=
HOST=
NODE_ENV=
DEBUG=