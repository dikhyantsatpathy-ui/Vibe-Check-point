# Google Identity Services client ID for the authority sign-in.
#
# REQUIRED. There is no fallback any more: sign-in will not initialise without
# it, and GoogleSignIn.tsx logs a console error saying so. A silent fallback
# would sign users in against whichever OAuth project happened to be hardcoded,
# while the backend's allow-list was evaluated for a different audience.
#
# Must be the SAME client ID as GOOGLE_CLIENT_ID in the root .env -- the
# frontend presents the credential, the backend verifies it.
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Dev-only: where the Vite dev server proxies /api calls to.
# Defaults to http://localhost:8000; set to your backend when it runs elsewhere,
# e.g. VITE_PROXY_TARGET=http://127.0.0.1:8001
VITE_PROXY_TARGET=http://localhost:8000
