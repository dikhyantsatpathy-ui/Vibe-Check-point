{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-NoCap-Probe",
          "value": "probe-17"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/probe-node",
      "destination": "/api/probe"
    },
    {
      "source": "/probe-a",
      "destination": "/api/index"
    },
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ]
}
